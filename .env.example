# Copy to .env and fill in. Restart `npm run dev` and `npm run server` after changing.
# The main admin login is not set here: it lives in database/12_main_admin.sql.

# ── Supabase (Dashboard → Project Settings → API Keys) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only, never expose. Used to verify users, confirm payments and register landlords.
SUPABASE_SERVICE_ROLE_KEY=

# ── Phone notifications (Web Push) ──
# Generate once with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@renta.ug

# ── Mobile money: MTN / Airtel via Flutterwave (https://app.flutterwave.com → Settings → API keys) ──
# Leave FLW_SECRET_KEY empty for TEST MODE (no real money; payments auto-approve after a few seconds).
FLW_SECRET_KEY=
# Your own secret: also paste it in Flutterwave → Settings → Webhooks → "Secret hash"
FLW_WEBHOOK_HASH=
# Used as the payer email when a tenant's account has none
PAYMENT_EMAIL_FALLBACK=payments@renta.ug

PORT=4242
CLIENT_URL=http://localhost:5173
