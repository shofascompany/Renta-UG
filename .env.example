# Copy to .env and fill in. Restart `npm run dev` and `npm run server` after changing.
# The main admin login is not set here: it lives in database/12_main_admin.sql.

# ── Supabase (Dashboard → Project Settings → API Keys) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only, never expose. Used to verify users, confirm payments and register landlords.
SUPABASE_SERVICE_ROLE_KEY=

# ── Phone notifications (Web Push) ──
# Generate once with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@renta.ug

# ── Mobile money ──
# Nothing to set here. Each landlord adds the numbers they receive rent on (MTN, Airtel)
# in the app (Payments → Mobile money numbers). Tenants send money from their phone and the landlord confirms it.

PORT=4242
CLIENT_URL=http://localhost:5173

# Sign-up email codes (Gmail + App password)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
VITE_SUPPORT_EMAIL=

# SMS from "Renta UG" when a landlord confirms a payment (Africa's Talking)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
