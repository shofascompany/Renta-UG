# Copy to .env and fill in. Restart `npm run dev` and `npm run server` after changing.
# The main admin login is not set here: it lives in database/12_main_admin.sql.

# ── Supabase (Dashboard → Project Settings → API Keys) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only, never expose. Used to verify users, confirm payments and register landlords.
SUPABASE_SERVICE_ROLE_KEY=

# ── Phone notifications (Web Push) ──
# Generate once with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@renta.ug

# ── Mobile money: real MTN MoMo + Airtel Money payments ──
# Recommended: Relworx (Kampala). Create a business account at https://payments.relworx.com,
# finish KYC, then copy your API key and business account number here.
# In the Relworx dashboard set the webhook URL to:  https://<your-server>/api/momo/relworx-webhook
# (Payments are also checked automatically every 15 s, so they confirm even without the webhook.)
RELWORX_API_KEY=0b489140a3ceb1.KimEY-UAGvOmNISmiHLq4w
RELWORX_ACCOUNT_NO=REL40364A81C0

# Alternative: Flutterwave (https://app.flutterwave.com → Settings → API keys). Used only if Relworx isn't set.
FLW_SECRET_KEY=

# Only for trying the app: true = fake payments that approve themselves. Never on a real server.
PAYMENTS_TEST_MODE=false
# Your own secret: also paste it in Flutterwave → Settings → Webhooks → "Secret hash"
FLW_WEBHOOK_HASH=
# Used as the payer email when a tenant's account has none
PAYMENT_EMAIL_FALLBACK=payments@renta.ug

PORT=4242
CLIENT_URL=http://localhost:5173
