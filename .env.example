# Copy to .env and fill in. Restart `npm run dev` and `npm run server` after changing.
# The main admin login is not set here: it lives in database/12_main_admin.sql.

# ── Supabase (Dashboard → Project Settings → API Keys) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only, never expose. Used to verify users, confirm payments and register landlords.
SUPABASE_SERVICE_ROLE_KEY=

# ── Phone notifications (Web Push) ──
# Generate once with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@renta.ug

# ── Mobile money ──
# Nothing to set here. Each landlord adds the numbers they receive rent on (MTN, Airtel)
# in the app (Payments → Mobile money numbers). Tenants send money from their phone and the landlord confirms it.

PORT=4242
CLIENT_URL=http://localhost:5173

# Sign-up email codes (Gmail + App password)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Resend (better inbox delivery than Gmail). When RESEND_API_KEY and MAIL_FROM are both set, Resend is used.
# MAIL_FROM must be on the domain you verified in Resend, e.g. Renta UG <no-reply@your-domain.com>
RESEND_API_KEY=
# Optional, Resend only: where replies go (e.g. your support inbox)
MAIL_REPLY_TO=
VITE_SUPPORT_EMAIL=


# Permanent landlord account (ngumisiriza@gmail.com): its fixed password, applied with npm run permanent-account. Local only.
PERMANENT_ACCOUNT_PASSWORD=

# Demo accounts for `npm run screenshots` (pictures of the app for docs/Renta-UG-PDR.pdf). Local only.
SHOT_LANDLORD_EMAIL=
SHOT_LANDLORD_PASSWORD=
SHOT_TENANT_EMAIL=
SHOT_TENANT_PASSWORD=
SHOT_ADMIN_EMAIL=
SHOT_ADMIN_PASSWORD=
